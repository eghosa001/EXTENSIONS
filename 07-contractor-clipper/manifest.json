{
  "manifest_version": 3,
  "name": "Contractor Clipper",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Clip supplier products, reuse pricing libraries, and build professional contractor estimates.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Contractor Clipper",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Contractor Clipper"
    }
  },
  "optional_host_permissions": [
    "https://procurasheet-billing.onrender.com/*"
  ],
  "homepage_url": "https://contractor-clipper.onrender.com/"
}
