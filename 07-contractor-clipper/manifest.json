{
  "manifest_version": 3,
  "name": "Contractor Clipper",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "description": "Clip products from supplier websites into contractor project quotes and estimates.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Contractor Clipper"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
