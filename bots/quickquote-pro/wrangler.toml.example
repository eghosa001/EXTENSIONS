name = "quickquote-pro"
main = "worker.mjs"
compatibility_date = "2026-10-01"
# Copy into private wrangler.toml and configure your real D1 ID.
[[d1_databases]]
binding = "DB"
database_name = "quickquote-pro"
database_id = "REPLACE_WITH_REAL_D1_DATABASE_ID"
[vars]
# Charge no users before Telegram Stars payment & refund testing.
PAYMENTS_ENABLED = "false"
