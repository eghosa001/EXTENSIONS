{
  "manifest_version": 3,
  "name": "ProcuraSheet — PO CSV Converter",
  "version": "1.0.0",
  "description": "Convert supplier CSV/XLSX sheets into validated purchase-order CSVs compatible with Shopify.",
  "permissions": ["storage"],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "ProcuraSheet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png"
    }
  },
  "homepage_url": "https://github.com/eghosa001/EXTENSIONS/tree/main/01-supplier-sheet-shopify-po"
}
