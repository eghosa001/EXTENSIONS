{
  "manifest_version": 3,
  "name": "Contractor Clipper",
  "version": "0.2.0",
  "description": "Clip products from supplier websites into contractor project quotes and estimates.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Contractor Clipper"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
